\begin{tikzpicture}
\begin{axis}[
    width=\linewidth,
    height=6.0cm,
    xlabel={Experimental binder-loss fraction},
    ylabel={Mean AUC$_{0.1}$ across models},
    xmin=0.0,
    xmax=0.65,
    ymin=0.47,
    ymax=0.82,
    tick label style={font=\scriptsize},
    label style={font=\small},
    grid=major,
    grid style={draw=gray!15}
]

% Random-reference level
\draw[dashed,gray]
    (axis cs:0.0,0.5) --
    (axis cs:0.65,0.5);

% One point per mutation
\addplot[
    only marks,
    mark=*,
    mark size=1.8pt
]
table[
    x=Binder_Loss_Fraction,
    y=Mean_AUC01,
    col sep=comma
]
{{{DATA:fig7_source.csv}}};

% Optional linear trend line
\addplot[
    no marks,
    thick
]
table[
    x=Binder_Loss_Fraction,
    y={create col/linear regression={y=Mean_AUC01}},
    col sep=comma
]
{{{DATA:fig7_source.csv}}};

\end{axis}
