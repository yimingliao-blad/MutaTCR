% TEMPLATE for fig5 - rendered by stages/stage7_figures.py into results/figures/fig5.tex
% A DATA placeholder is replaced with the source table's filename; pgfplots finds it via
% the table search path set by the including document. Edit this file to change the figure.
\begin{tikzpicture}
\begin{axis}[
    width=0.85\linewidth,
    height=6.0cm,
    xmin=1.5,
    xmax=9.5,
    ymin=0.5,
    ymax=8.5,
    xlabel={Peptide position},
    ylabel={Model},
    xtick={2,3,4,5,6,7,8,9},
    xticklabels={P2,P3,P4,P5,P6,P7,P8,P9},
    ytick={1,2,3,4,5,6,7,8},
    yticklabels={
        ERGO,
        EPACT,
        PanPep,
        TITAN,
        NetTCR,
        NetTCR2.2,
        ERGO2,
        SCEPTR
    },
    tick label style={font=\scriptsize},
    label style={font=\small},
    point meta min=0.48,
    point meta max=0.80,
    colormap name=aucmap,
    colorbar,
    colorbar style={
        ylabel={Mean AUC$_{0.1}$},
        ylabel style={font=\small},
        yticklabel style={font=\scriptsize}
    }
]

% Data: analysis/exp3.py -> mutation_specific_auc.csv, averaged per model x position
% (via make_figure_data.py). Row index y = 1..8 in the yticklabels order above.
\addplot[
    scatter,
    only marks,
    mark=square*,
    mark size=10pt,
    scatter src=explicit
]
table[
    x=x,
    y=y,
    meta=auc01,
    col sep=comma
]{{{DATA:fig5_source.csv}}};

% Highlight the best-performing model at each position (argmax computed from the same data)
\addplot[
    only marks,
    mark=square*,
    mark size=12pt,
    mark options={
        draw=black,
        fill opacity=0,
        line width=1.2pt
    }
]
table[
    x=x,
    y=y,
    col sep=comma
]{{{DATA:fig5_best_source.csv}}};

\end{axis}
\end{tikzpicture}