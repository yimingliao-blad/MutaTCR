manuscript/*.aux
manuscript/*.log
manuscript/*.bbl
manuscript/*.blg
manuscript/*.out
manuscript/*.synctex.gz
manuscript/build.log
manuscript/p3.log
__pycache__/
*.pyc
.DS_Store
