@article {rajitha23,
    author = {Rajitha, Rajeshwar T. and Demerdash, Omar and Smith, Jeremy C.},
    title = {TCR-H: Machine Learning Prediction of T-cell Receptor Epitope Binding on Unseen Datasets},
    elocation-id = {2023.11.28.569077},
    year = {2023},
    doi = {10.1101/2023.11.28.569077},
    publisher = {Cold Spring Harbor Laboratory},
    abstract = {AI/ML approaches to predicting T-cell epitope specificity achieve impressive results on test sets which include epitope sequences that are also part of the training set, but fail to generalize to test sets consisting of epitopes and TCRs that are not included in the training set i.e., that are unseen. We present TCR-H, a supervised classification ML model using physicochemical features trained on the largest dataset of binding and non-binding data available to date. We used only experimentally validated non-binders as negative datapoints. TCR-H exhibits an area under the curve of the receiver operator characteristic (AUC of ROC) of 0.87 for epitope hard splitting (i.e test sets with all epitopes unseen), 0.92 for TCR hard splitting and 0.89 for strict splitting in which neither the epitopes nor the TCRs are present in the training data. TCR-H may thus represent a significant step towards general applicability of epitope:TCR specificity prediction.Competing Interest StatementThe authors have declared no competing interest.},
    URL = {https://www.biorxiv.org/content/early/2023/11/29/2023.11.28.569077},
    eprint = {https://www.biorxiv.org/content/early/2023/11/29/2023.11.28.569077.full.pdf},
    journal = {bioRxiv}
}

@article{liu23kd,
    abstract = {High hit rates from initial ligand-observed NMR screening can make it challenging to prioritize which hits to follow up, especially in cases where there are no available crystal structures of these hits bound to the target proteins or other strategies to provide affinity ranking. Here, we report a reproducible, accurate, and versatile quantitative ligand-observed NMR assay, which can determine K(d) values of fragments in the affinity range of low μM to low mM using transverse relaxation rate R(2) as the observable parameter. In this study, we examined the theory and proposed a mathematical formulation to obtain K(d) values using non-linear regression analysis. We designed an assay format with automated sample preparation and simplified data analysis. Using tool compounds, we explored the assay reproducibility, accuracy, and detection limits. Finally, we used this assay to triage fragment hits, yielded from fragment screening against the CRBN/DDB1 complex.},
