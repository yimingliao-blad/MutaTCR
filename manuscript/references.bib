@article{yaotongSETESequencebasedEnsemble2020,
	title = {{SETE}: {Sequence}-based {Ensemble} learning approach for {TCR} {Epitope} binding prediction},
	volume = {87},
	doi = {10.1016/j.compbiolchem.2020.107281},
	abstract = {Abstract   Prediction the binding of T cell receptors (TCRs) to epitopes plays a vital role in the immunotherapy, and its specific binding helps guide the development of therapeutic vaccines and cancer treatments. Many prediction methods attempted to explain the relationship between TCR repertoires from different aspects such as the V(D)J Gene locus and the biophysical features of amino acids molecules, but the extraction of these features is time consuming and the performance of these models are limited. Few studies have investigated how k-mers formed by adjacent amino acids in TCR sequences direct the epitope recognition, and the specific mechanism of TCR and epitope is still unclear. Motivated by these, we presented SETE (Sequence-based Ensemble learning approach for TCR Epitope binding prediction), a novel model to predict the TCRs binding epitopes accurately. The model deconstructed the CDR3β sequence to short amino acid chains as features and learned the pattern of them between different TCR repertoires with gradient boosting decision tree algorithm. Experiments have demonstrated that SETE can be helpful in predicting the TCRs’ corresponding epitopes and it outperforms other state-of-the-art methods in predicting the epitope specificity of TCR on VDJdb data set. The source codes have been uploaded at  https://github.com/wonanut/SETE  for academic usage only.},
	journal = {Computational Biology and Chemistry},
	author = {{Yao Tong} and Yao, Tong and {Jiayin Wang} and Wang, Jiayin and {Zheng Tian} and Zheng, Tian and {Xuanping Zhang} and Zhang, Xuanping and {Xiao Xiao} and Xiao, Xiao and {Xiaoyan Zhu} and Zhu, Xiaoyan and Zhu, Xiaoyan and {Xin Lai} and Lai, Xin and {Xiang Liu} and Liu, Xiang},
	month = aug,
	year = {2020},
	doi = {10.1016/j.compbiolchem.2020.107281},
	pmid = {32623023},
	note = {MAG ID: 3036326371
