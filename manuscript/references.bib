}

@article{hashemkoohyComparisonClusteringModels2023,
	title = {A comparison of clustering models for inference of {T} cell receptor antigen specificity},
	doi = {10.1101/2023.08.04.551940},
	abstract = {Abstract The vast potential sequence diversity of TCRs and their ligands has presented an historic barrier to computational prediction of TCR epitope specificity, a holy grail of quantitative immunology. One common approach is to cluster sequences together, on the assumption that similar receptors bind similar epitopes. Here, we provide an independent evaluation of widely used clustering algorithms for TCR specificity inference, observing some variability in predictive performance between models, and marked differences in scalability. Despite these differences, we find that different algorithms produce clusters with high degrees of similarity for receptors recognising the same epitope. Our analysis highlights an unmet need for improvement of complex models over a simple Hamming distance comparator, and strengthens the case for use of clustering models in TCR specificity inference.},
	journal = {bioRxiv},
	author = {{Hashem Koohy} and {D. R. Hudson} and {Alexander L R Lubbock} and {Mark Basham}},
	month = aug,
