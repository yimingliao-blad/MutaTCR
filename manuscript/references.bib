@article{meysmanBenchmarkingSolutionsTcell2022,
	title = {Benchmarking solutions to the {T}-cell receptor epitope prediction problem: {IMMREP22} workshop report},
	doi = {10.1101/2022.10.27.514020},
	abstract = {Abstract Many different solutions to predicting the cognate epitope target of a T-cell receptor (TCR) have been proposed. However several questions on the advantages and disadvantages of these different approaches remain unresolved, as most methods have only been evaluated within the context of their initial publications and data sets. Here, we report the findings of the first public TCR-epitope prediction benchmark performed on 23 prediction models in the context of the ImmRep 2022 TCR-epitope specificity workshop. This benchmark revealed that the use of paired-chain alpha-beta, as well as CDR1/2 or V/J information, when available, improves classification obtained with CDR3 data, independent of the underlying approach. In addition, we found that straight-forward distance-based approaches can achieve a respectable performance when compared to more complex machine-learning models. Finally, we highlight the need for a truly independent follow-up benchmark and provide recommendations for the design of such a next benchmark.},
	journal = {Cold Spring Harbor Laboratory - bioRxiv},
	author = {Meysman, Pieter and {Pieter Meysman} and {Justin Barton} and {Justin Barton} and {Barbara Bravi} and {Barbara Bravi} and Cohen-Lavi, Liel and {Liel Cohen-Lavi} and {Vadim Karnaukhov} and {В. К. Карнаухов} and {Elias Lilleskov} and {Elias Lilleskov} and {Alessandro Montemurro} and {Alessandro Montemurro} and {Morten Nielsen} and {Morten Nielsen} and {Thierry Mora} and {Thierry Mora} and {Paul Pereira} and {Paul Pereira} and {Anna Postovskaya} and {Anna Postovskaya} and {Maria Rodriguez Martinez} and {María Rodríguez Martínez} and Fernandez-de-Cossio-Diaz, Jorge and {Jorge Fernández-de-Cossio-Díaz} and {Alexandra Vujkovic} and {Alexandra Vujkovic} and {Aleksandra Walczak} and {Aleksandra M. Walczak} and {Anna Weber} and {Anna Weber} and {Rose Yin} and {Rose Yin} and {Anne Eugster} and {Anne Eugster} and Sharma, Virag and {Virag Sharma}},
	month = oct,
	year = {2022},
