@article{giulioisacchiniDeepGenerativeSelection2021,
	title = {Deep generative selection models of {T} and {B} cell receptor repertoires with {soNNia}.},
	volume = {118},
	doi = {10.1073/pnas.2023141118},
	abstract = {Subclasses of lymphocytes carry different functional roles to work together and produce an immune response and lasting immunity. Additionally to these functional roles, T and B cell lymphocytes rely on the diversity of their receptor chains to recognize different pathogens. The lymphocyte subclasses emerge from common ancestors generated with the same diversity of receptors during selection processes. Here, we leverage biophysical models of receptor generation with machine learning models of selection to identify specific sequence features characteristic of functional lymphocyte repertoires and subrepertoires. Specifically, using only repertoire-level sequence information, we classify CD4+ and CD8+ T cells, find correlations between receptor chains arising during selection, and identify T cell subsets that are targets of pathogenic epitopes. We also show examples of when simple linear classifiers do as well as more complex machine learning methods.},
	number = {14},
	journal = {Proceedings of the National Academy of Sciences of the United States of America},
	author = {{Giulio Isacchini} and Isacchini, Giulio and {Aleksandra M. Walczak} and Walczak, Aleksandra M. and {Thierry Mora} and Mora, Thierry and {Armita Nourmohammad} and Nourmohammad, Armita and Nourmohammad, Armita},
	year = {2021},
	doi = {10.1073/pnas.2023141118},
	pmid = {33795515},
	note = {MAG ID: 3151229614},
	pages = {2023141118},
	file = {Giulio Isacchini et al. - 2021 - Deep generative selection models of T and B cell r.pdf:/Users/yimingliao/Zotero/storage/X56NJAX7/Giulio Isacchini et al. - 2021 - Deep generative selection models of T and B cell r.pdf:application/pdf},
}

@article{zacharysethnaPopulationVariabilityGeneration2020,
	title = {Population variability in the generation and selection of {T}-cell repertoires},
	volume = {16},
	doi = {10.1371/journal.pcbi.1008394},
	abstract = {The diversity of T-cell receptor (TCR) repertoires is achieved by a combination of two intrinsically stochastic steps: random receptor generation by VDJ recombination, and selection based on the recognition of random self-peptides presented on the major histocompatibility complex. These processes lead to a large receptor variability within and between individuals. However, the characterization of the variability is hampered by the limited size of the sampled repertoires. We introduce a new software tool SONIA to facilitate inference of individual-specific computational models for the generation and selection of the TCR beta chain (TRB) from sequenced repertoires of 651 individuals, separating and quantifying the variability of the two processes of generation and selection in the population. We find not only that most of the variability is driven by the VDJ generation process, but there is a large degree of consistency between individuals with the inter-individual variance of repertoires being about ∼2\% of the intra-individual variance. Known viral-specific TCRs follow the same generation and selection statistics as all TCRs.},
	number = {12},
	journal = {PLOS Computational Biology},
	author = {{Zachary Sethna} and Sethna, Zachary and {Giulio Isacchini} and Isacchini, Giulio and {Giulio Isacchini} and {Thomas Dupic} and {Thomas Dupic} and {T. Dupic} and Dupic, Thomas and {Thierry Mora} and Mora, Thierry and {Aleksandra M. Walczak} and Walczak, Aleksandra M. and {Yuval Elhanati} and Elhanati, Yuval},
	year = {2020},
	doi = {10.1371/journal.pcbi.1008394},
	pmcid = {7725366},
	pmid = {33296360},
	note = {MAG ID: 3111056735
S2ID: 50e758df447b20cf89beb75e5eb223dffad86206},
	file = {Zachary Sethna et al. - 2020 - Population variability in the generation and selec.pdf:/Users/yimingliao/Zotero/storage/CL4GGAZP/Zachary Sethna et al. - 2020 - Population variability in the generation and selec.pdf:application/pdf},
}

