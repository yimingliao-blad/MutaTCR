	note = {MAG ID: 4307476118
S2ID: 27ad9bea3b8d070b34e1a218e4133c4a5cc0ac11},
	file = {Meysman et al. - 2022 - Benchmarking solutions to the T-cell receptor epit.pdf:/Users/yimingliao/Zotero/storage/U3LU82EV/Meysman et al. - 2022 - Benchmarking solutions to the T-cell receptor epit.pdf:application/pdf},
